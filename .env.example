# Copy to .env and fill in. Both values are public and safe to ship in the app;
# access is protected by Row Level Security in the database.
# Find them in Supabase: Project Settings -> API Keys (use the "publishable" key,
# or the legacy "anon" key on older projects).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Never put secret keys here (no service_role / secret key, no Gemini key).
# The Gemini key lives only in Supabase:
#   npx supabase secrets set GEMINI_API_KEY=...
