# Copy to .env and fill in (Phase 2). Both values are public and safe to ship in the app;
# access is protected by Row Level Security in the database.
# Find them in Supabase: Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Never put secret keys here. The Gemini key lives only in Supabase:
#   npx supabase secrets set GEMINI_API_KEY=...
