    "deno": "^2.9.6",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.9",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.16",
    "prettier": "^3.10.1",
    "supabase": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm run functions:check && npm run lint && npm run format:check && npm test",
    "db:types": "supabase gen types typescript --remote --schema public > src/types/database.ts && prettier --write src/types/database.ts",
    "db:push": "supabase db push --remote",
    "functions:check": "deno check supabase/functions/parse-receipt/index.ts",
    "functions:deploy": "supabase functions deploy parse-receipt --use-api"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo"
  }
